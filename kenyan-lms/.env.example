# =================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR LOCAL VALUES.
# NEVER COMMIT .env TO GIT.
# =================================================================

# --- Django ---
# Generate a fresh key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Required only when DJANGO_SETTINGS_MODULE=config.settings_prod
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173
# Production requires a key separate from the local SECRET_KEY above.
PRODUCTION_SECRET_KEY=replace-with-a-different-long-random-secret-key
# Only list the direct peer that terminates TLS for this process.
TRUSTED_PROXY_IPS=127.0.0.1
# Public SPA origin used in password-reset links.
FRONTEND_BASE_URL=http://127.0.0.1:5173
# Shared cache for multi-worker throttles; leave blank for local-memory cache.
CACHE_URL=
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
CONTENT_SECURITY_POLICY=default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; upgrade-insecure-requests

# --- Authentication and abuse limits (optional) ---
PASSWORD_RESET_TIMEOUT=3600
# One-hour session; use 1800 for 30 minutes. Activity refreshes the expiry.
SESSION_COOKIE_AGE=3600
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
SESSION_SAVE_EVERY_REQUEST=True
LOGIN_FAIL_MAX=5
LOGIN_LOCKOUT_SECONDS=900
RESET_REQUEST_MAX=5
RESET_REQUEST_WINDOW_SECONDS=3600
LOGIN_THROTTLE_RATE=100/hour
REGISTER_THROTTLE_RATE=20/hour
RESET_THROTTLE_RATE=20/hour
TUTOR_THROTTLE_RATE=120/hour
EXPORT_THROTTLE_RATE=60/hour

# --- Upload and import limits (optional) ---
CONTENT_RESOURCE_MAX_UPLOAD_BYTES=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
LEARNER_CSV_MAX_BYTES=1048576
LEARNER_CSV_MAX_ROWS=500

# --- Email (Django 6 MAILERS) ---
# Local development uses the console backend. Production uses these values.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT=20
DEFAULT_FROM_EMAIL=KLB LMS <no-reply@klb.example.com>

# --- PostgreSQL ---
DB_NAME=lms
DB_USER=postgres
DB_PASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Optional tutor HTTP adapter (leave local unless explicitly configured) ---
KLB_TUTOR_PROVIDER=local
KLB_TUTOR_API_URL=
KLB_TUTOR_API_KEY=
KLB_TUTOR_ALLOWED_HOSTS=

# --- Frontend (Vite only exposes variables beginning with VITE_) ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api
