# =================================================================
# Environment files and secrets
# -----------------------------------------------------------------
# The .env file holds real passwords and must NEVER be committed.
# .env.example is the safe template that IS committed.
# =================================================================
.env
.env.*
!.env.example

# =================================================================
# Python / Django
# =================================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
*.log
logs/
db.sqlite3
/staticfiles/
/media/

# =================================================================
# Node / React / Vite
# =================================================================
node_modules/
dist/
build/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =================================================================
# Generated PWA files (rebuilt automatically during a production build)
# =================================================================
frontend/public/sw.js
frontend/public/workbox-*.js

# =================================================================
# Native wrapper build output (Capacitor)
# -----------------------------------------------------------------
# Native platform projects may be committed, but generated builds and local
# signing material must not be.
# =================================================================
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/build/
frontend/ios/App/Pods/
frontend/ios/App/build/
frontend/ios/DerivedData/
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision

# =================================================================
# Testing and coverage output
# =================================================================
.pytest_cache/
.coverage
htmlcov/

# =================================================================
# Editors and operating system files
# =================================================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
